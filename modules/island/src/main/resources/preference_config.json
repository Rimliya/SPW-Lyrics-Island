{
  "configs": [
    {
      "title": "显示与交互",
      "config": "island.json",
      "preferences": [
        {
          "type": "switch",
          "key": "enabled",
          "title": "显示词岛",
          "default_value": true
        },
        {
          "type": "button",
          "title": "找回词岛",
          "summary": "显示词岛、解除鼠标穿透并回到主屏幕顶部。",
          "arrow_type": "none",
          "on_click": "io.github.gaboron.spwisland.host.IslandPlugin.recover"
        },
        {
          "type": "switch",
          "key": "hide_paused",
          "title": "暂停时隐藏",
          "default_value": false
        },
        {
          "type": "switch",
          "key": "hide_fullscreen",
          "title": "全屏时隐藏（Windows）",
          "default_value": true
        },
        {
          "type": "switch",
          "key": "click_through",
          "title": "鼠标穿透",
          "default_value": false
        },
        {
          "type": "switch",
          "key": "auto_hide_on_hover",
          "title": "鼠标经过时自动隐藏",
          "default_value": false,
          "summary": "开启后同时穿透鼠标，经过词岛时隐藏，移开后恢复。Linux 支持 X11、KDE Wayland；GNOME Wayland 需安装配套扩展。"
        },
        {
          "type": "switch",
          "key": "scroll_volume",
          "title": "鼠标滚轮调节音量",
          "default_value": false,
          "summary": "悬停展开后滚动，每格调节 2% 的 SPW 音量；音量条可点击、拖动。穿透或悬停隐藏时不可用。"
        },
        {
          "type": "switch",
          "key": "reduced_motion",
          "title": "低性能模式",
          "default_value": false,
          "summary": "降低刷新率，使用简化高亮和模拟频谱，停用实时音频捕获、液态玻璃与复杂动效。"
        }
      ]
    },
    {
      "title": "歌词显示",
      "config": "island.json",
      "preferences": [
        {
          "type": "switch",
          "key": "translation",
          "title": "显示翻译",
          "default_value": true
        },
        {
          "type": "switch",
          "key": "karaoke",
          "title": "逐字高亮与长音强调",
          "default_value": true
        },
        {
          "type": "switch",
          "key": "force_karaoke",
          "title": "强制逐字显示",
          "default_value": false,
          "summary": "开启逐字高亮后，为普通 LRC 按行时长估算逐字进度；估算歌词不应用长音发光。原生逐字时间轴优先。"
        },
        {
          "type": "seekbar",
          "key": "offset_ms",
          "title": "逐字高亮偏移 ms",
          "default_value": 0,
          "min": -2000,
          "max": 2000
        },
        {
          "type": "switch",
          "key": "experimental_multi_line",
          "title": "实验性多行歌词",
          "default_value": false,
          "summary": "使用 SPW 提供的完整歌词时间轴，保留尚未结束的已播歌词；发生重叠时自动展开显示。"
        },
        {
          "type": "switch",
          "key": "lyric_cover_color",
          "title": "歌词高亮与辉光使用封面颜色",
          "default_value": false,
          "summary": "从本地音频内嵌封面或同目录 cover/folder 图片取色，无封面时使用默认颜色。"
        }
      ]
    },
    {
      "title": "字体",
      "config": "island.json",
      "preferences": [
        {
          "type": "seekbar",
          "key": "font_size",
          "title": "字号",
          "default_value": 22,
          "min": 12,
          "max": 72
        },
        {
          "type": "button",
          "title": "歌词字体（Windows）",
          "summary": "打开字体窗口，选择字体提供的字形样式，并预览词岛效果。",
          "arrow_type": "arrow",
          "on_click": "io.github.gaboron.spwisland.host.IslandPlugin.chooseFont"
        },
        {
          "type": "edittext",
          "key": "font_family",
          "title": "歌词字体（Linux）",
          "default_value": "@island-default",
          "summary": "Linux 使用此项设置字体；@island-default 使用内置苹方，留空使用内置 MiSans。Windows 请使用上方字体窗口。"
        },
        {
          "type": "list",
          "key": "font_weight",
          "title": "歌词字重（Linux）",
          "entries": [
            "极细 100",
            "细体 300",
            "次细 350",
            "常规 400",
            "中等 500",
            "粗体 700",
            "极粗 900"
          ],
          "entry_values": [
            "100",
            "300",
            "350",
            "400",
            "500",
            "700",
            "900"
          ],
          "default_value": "400",
          "summary": "Linux 使用此项选择字重。自选字体缺少对应字重时使用最接近的已有字重。"
        }
      ]
    },
    {
      "title": "外观与布局",
      "config": "island.json",
      "preferences": [
        {
          "type": "list",
          "key": "shape",
          "title": "外观",
          "entries": [
            "圆角矩形",
            "胶囊",
            "方形",
            "顶部刘海"
          ],
          "entry_values": [
            "rounded",
            "capsule",
            "square",
            "notch"
          ],
          "default_value": "rounded"
        },
        {
          "type": "seekbar",
          "key": "corner_roundness",
          "title": "圆角大小 %",
          "default_value": 60,
          "min": 0,
          "max": 100,
          "summary": "0 为直角，100 为最大圆角；圆角会随词岛高度自动缩放，胶囊与方形忽略此项。"
        },
        {
          "type": "switch",
          "key": "squircle",
          "title": "连续曲率圆角",
          "default_value": true,
          "summary": "开启后圆角使用连续曲率（squircle）；关闭则使用标准圆弧。"
        },
        {
          "type": "list",
          "key": "height_mode",
          "title": "词岛高度",
          "entries": [
            "自动",
            "固定"
          ],
          "entry_values": [
            "auto",
            "fixed"
          ],
          "default_value": "auto"
        },
        {
          "type": "seekbar",
          "key": "fixed_height",
          "title": "固定高度",
          "default_value": 58,
          "min": 40,
          "max": 200,
          "summary": "仅在“词岛高度”选择“固定”时生效。"
        },
        {
          "type": "list",
          "key": "text_alignment",
          "title": "歌词对齐",
          "entries": [
            "左对齐",
            "居中",
            "右对齐"
          ],
          "entry_values": [
            "left",
            "center",
            "right"
          ],
          "default_value": "center"
        },
        {
          "type": "list",
          "key": "outline_style",
          "title": "歌词描边",
          "entries": [
            "硬边",
            "向外渐变",
            "溶边（轻量）"
          ],
          "entry_values": [
            "hard",
            "gradient",
            "dissolve"
          ],
          "default_value": "hard",
          "summary": "仅在封面取色导致歌词与背景对比度不足时绘制。"
        },
        {
          "type": "seekbar",
          "key": "max_width",
          "title": "最大宽度",
          "default_value": 640,
          "min": 280,
          "max": 1200
        },
        {
          "type": "switch",
          "key": "fixed_width",
          "title": "固定词岛宽度",
          "default_value": false,
          "summary": "开启后词岛始终使用最大宽度；关闭时按歌词内容自适应。"
        }
      ]
    },
    {
      "title": "背景与进度",
      "config": "island.json",
      "preferences": [
        {
          "type": "list",
          "key": "background_style",
          "title": "背景样式（Windows）",
          "entries": [
            "经典背景",
            "液态玻璃（实验性）"
          ],
          "entry_values": [
            "classic",
            "liquid_glass"
          ],
          "default_value": "classic",
          "summary": "液态玻璃使用实时桌面模糊、边缘折射、轻微色散与方向高光，需要 Windows 11 及 SDR 显示器。背景不取封面颜色；不透明度调节中性基底。启用时词岛从系统录屏中排除；低性能或捕获不可用时使用经典背景，原因见关于窗口。液态玻璃与“经典背景材质”互斥：启用液态玻璃时，纯色、渐变、流光和迷彩均不会绘制或叠加；切回经典背景后材质设置才生效。"
        },
        {
          "type": "list",
          "key": "background_material",
          "title": "经典背景材质",
          "entries": [
            "纯色",
            "线性渐变",
            "多色流光",
            "封面迷彩碎色"
          ],
          "entry_values": [
            "solid",
            "gradient",
            "flow",
            "mosaic"
          ],
          "default_value": "solid",
          "summary": "仅经典背景生效；选择液态玻璃时该材质完全不绘制，两套背景不会叠加。流光与迷彩使用封面多色调色板。"
        },
        {
          "type": "seekbar",
          "key": "gradient_angle",
          "title": "渐变角度 °",
          "default_value": 135,
          "min": 0,
          "max": 360
        },
        {
          "type": "edittext",
          "key": "gradient_start",
          "title": "渐变起始色（#RRGGBB）",
          "default_value": "",
          "summary": "留空时使用背景色派生；支持 #RRGGBB 或 RRGGBB。"
        },
        {
          "type": "edittext",
          "key": "gradient_end",
          "title": "渐变结束色（#RRGGBB）",
          "default_value": "",
          "summary": "留空时使用频谱主色。"
        },
        {
          "type": "seekbar",
          "key": "flow_speed",
          "title": "流光速度 %",
          "default_value": 100,
          "min": 10,
          "max": 400
        },
        {
          "type": "seekbar",
          "key": "mosaic_block",
          "title": "迷彩碎色块大小 px",
          "default_value": 16,
          "min": 4,
          "max": 64
        },
        {
          "type": "seekbar",
          "key": "opacity",
          "title": "背景不透明度 %",
          "default_value": 96,
          "min": 35,
          "max": 100
        },
        {
          "type": "switch",
          "key": "background_cover_color",
          "title": "背景使用封面颜色",
          "default_value": true,
          "summary": "从本地音频内嵌封面或同目录 cover/folder 图片取色，无封面时使用默认颜色。"
        },
        {
          "type": "list",
          "key": "background_progress",
          "title": "背景播放进度样式",
          "entries": [
            "关闭",
            "背景注水",
            "边缘细线"
          ],
          "entry_values": [
            "off",
            "fill",
            "top_line"
          ],
          "default_value": "off",
          "summary": "胶囊沿顶部、刘海沿底部显示细线；开始隐藏或展开控件时淡出，恢复稳定收起状态后淡入，低性能模式下关闭。"
        }
      ]
    },
    {
      "title": "封面与频谱",
      "config": "island.json",
      "preferences": [
        {
          "type": "switch",
          "key": "cover_visible",
          "title": "显示封面",
          "default_value": true
        },
        {
          "type": "seekbar",
          "key": "cover_scale",
          "title": "封面缩放 %",
          "default_value": 100,
          "min": 40,
          "max": 160
        },
        {
          "type": "list",
          "key": "leading_content",
          "title": "左侧插槽",
          "entries": [
            "专辑封面",
            "实时频谱",
            "不显示"
          ],
          "entry_values": [
            "cover",
            "spectrum",
            "none"
          ],
          "default_value": "cover",
          "summary": "封面来自本地音频内嵌图片或同目录 cover/folder 图片。"
        },
        {
          "type": "list",
          "key": "trailing_content",
          "title": "右侧插槽",
          "entries": [
            "播放状态",
            "频谱",
            "时钟",
            "不显示"
          ],
          "entry_values": [
            "status",
            "spectrum",
            "clock",
            "none"
          ],
          "default_value": "spectrum",
          "summary": "频谱只使用右侧四柱或右侧五柱布局；底部布局在歌词区底边绘制。"
        },
        {
          "type": "list",
          "key": "spectrum_layout",
          "title": "频谱布局",
          "entries": [
            "不显示",
            "右侧四柱",
            "右侧五柱",
            "底部频谱"
          ],
          "entry_values": [
            "none",
            "right_bars",
            "right_five",
            "bottom"
          ],
          "default_value": "right_bars",
          "summary": "选择“不显示”会停止音频采集。右侧五柱由四频段插值得到。"
        },
        {
          "type": "list",
          "key": "spectrum_color_mode",
          "title": "频谱取色",
          "entries": [
            "手动颜色",
            "封面主色",
            "随音量",
            "封面流光",
            "封面碎色"
          ],
          "entry_values": [
            "manual",
            "cover",
            "volume",
            "cover_flow",
            "mosaic"
          ],
          "default_value": "cover"
        },
        {
          "type": "edittext",
          "key": "spectrum_manual_color",
          "title": "手动频谱颜色（#RRGGBB）",
          "default_value": "",
          "summary": "仅在频谱取色选择“手动颜色”时使用；留空时使用封面主色。"
        },
        {
          "type": "list",
          "key": "spectrum_style",
          "title": "频谱样式",
          "entries": [
            "实心柱",
            "折线"
          ],
          "entry_values": [
            "solid",
            "polyline"
          ],
          "default_value": "solid"
        },
        {
          "type": "switch",
          "key": "spectrum_rounded",
          "title": "频谱柱圆角",
          "default_value": true
        },
        {
          "type": "seekbar",
          "key": "spectrum_opacity",
          "title": "频谱不透明度 %",
          "default_value": 100,
          "min": 20,
          "max": 100
        },
        {
          "type": "switch",
          "key": "clock_24h",
          "title": "时钟使用 24 小时制",
          "default_value": true
        },
        {
          "type": "list",
          "key": "clock_style",
          "title": "时钟字形",
          "entries": [
            "文本",
            "七段数码管",
            "点阵",
            "像素风"
          ],
          "entry_values": [
            "text",
            "seven",
            "dot",
            "pixel"
          ],
          "default_value": "dot"
        }
      ]
    },
    {
      "title": "OBS / Spout2",
      "config": "island.json",
      "preferences": [
        {
          "type": "switch",
          "key": "spout_enabled",
          "title": "OBS / Spout2 输出",
          "default_value": true,
          "summary": "独立透明画面；桌面隐藏或全屏时继续显示。OBS 需要 Spout2 Capture 接收插件。"
        },
        {
          "type": "edittext",
          "key": "spout_name",
          "title": "Spout2 发送器名称",
          "default_value": "SPW Lyrics Island",
          "summary": "使用英文、数字或空格；修改后在 OBS 重新选择发送器。"
        },
        {
          "type": "list",
          "key": "spout_fps",
          "title": "Spout2 帧率",
          "entries": [
            "30 FPS",
            "60 FPS"
          ],
          "entry_values": [
            "30",
            "60"
          ],
          "default_value": "30",
          "summary": "低性能模式固定约 15 FPS。选项可选 30 FPS / 60 FPS。"
        },
        {
          "type": "edittext",
          "key": "spout_width",
          "title": "Spout2 画布宽度",
          "default_value": "1280",
          "summary": "320–3840 像素，固定画布，词岛居中。"
        },
        {
          "type": "edittext",
          "key": "spout_height",
          "title": "Spout2 画布高度",
          "default_value": "512",
          "summary": "128–2160 像素，保留透明背景。"
        },
        {
          "type": "edittext",
          "key": "spout_adapter",
          "title": "Spout2 显卡编号",
          "default_value": "-1",
          "summary": "-1 自动，0 为第一张 DXGI 显卡。必须与 OBS 使用同一张显卡；出错后重新开关输出。"
        }
      ]
    },
    {
      "title": "工具与关于",
      "config": "island.json",
      "preferences": [
        {
          "type": "button",
          "title": "打开日志目录",
          "summary": "异常与关键操作日志默认开启，保留 10 天；词岛无法显示时也可使用。",
          "arrow_type": "none",
          "on_click": "io.github.gaboron.spwisland.host.IslandPlugin.openLogs"
        },
        {
          "type": "button",
          "title": "导出诊断包",
          "summary": "将日志与运行环境导出为 ZIP。分享前请检查异常堆栈中可能包含的隐私信息；不会自动上传。",
          "arrow_type": "none",
          "on_click": "io.github.gaboron.spwisland.host.IslandPlugin.exportDiagnostics"
        },
        {
          "type": "button",
          "title": "安装 GNOME 悬停隐藏支持（Linux）",
          "summary": "适用于 GNOME Wayland 45–50；首次安装或更新配套指针扩展后需重新登录。",
          "arrow_type": "none",
          "on_click": "io.github.gaboron.spwisland.host.IslandPlugin.installGnomePointer"
        },
        {
          "type": "button",
          "title": "关于与状态",
          "summary": "查看运行状态、Lyricify / AMLL 署名及许可证信息。",
          "arrow_type": "none",
          "on_click": "io.github.gaboron.spwisland.host.IslandPlugin.about"
        },
        {
          "type": "button",
          "title": "项目源代码（GitHub）",
          "summary": "查看源代码、反馈问题与参与贡献。",
          "arrow_type": "link",
          "on_click": "io.github.gaboron.spwisland.host.IslandPlugin.openSource"
        },
        {
          "type": "button",
          "title": "重置设置",
          "summary": "将所有词岛设置、字体和位置恢复为默认值；设置页中的数值可能需要重新打开后才会更新。",
          "arrow_type": "none",
          "on_click": "io.github.gaboron.spwisland.host.IslandPlugin.resetSettings"
        }
      ]
    }
  ]
}
